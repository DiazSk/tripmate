# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cesium static assets (regenerated by scripts/copy-cesium-assets.mjs)
/public/cesium/

# maplibre tile-parsing worker (regenerated by scripts/copy-maplibre-assets.mjs)
/public/maplibre/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# sqlite db
*.db

# cesium static assets (copied by scripts/copy-cesium-assets.mjs)
/public/cesium

# typescript
*.tsbuildinfo
next-env.d.ts

# browser performance captures — hundreds of MB to gigabytes each. The Chrome trace that
# diagnosed the main-thread scrolling was 1.1GB.
*-recording.json
Trace-*.json

# Claude — worktree scratch, local settings, and dev-server config stay untracked; the
# skills/ subdirectory is tracked (it's not machine-local — it's real planning content
# consumed at runtime by loadSkill(), and losing it silently breaks production features)
.claude/*
!.claude/skills/

# Impeccable
.impeccable/
# superpowers brainstorming companion
.superpowers/

# git worktree scratch space (superpowers subagent-driven-development)
.worktrees/

# scratch renders dropped into the served public/ dir while working on the export
# (`/api/trips/<id>/export` regenerates any of them). They are reachable at a public URL
# the moment they exist, so they must never be committed by accident.
/public/__tmp-*
