# Free Cesium ion account + access token: https://cesium.com/ion/signup
# Used to stream Google's Photorealistic 3D Tiles via createGooglePhotorealistic3DTileset().
# No Google Cloud project or billing account needed. Without this set, the map falls back
# to plain OpenStreetMap imagery on a flat-terrain globe.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Required in every environment (see CLAUDE.md) — POI suggestions silently degrade to none
# without it, they do not error.
OPENTRIPMAP_API_KEY=

# Sign up at yelp.com/developers or business.yelp.com/data/products/fusion. Provides a 30-day
# trial with 5,000 total calls, then paid usage-based plan (~$8–15 per 1,000 calls). This app's
# per-user call volume is low (roughly 1–2 calls per food stop, only when stated dietary needs exist),
# so real cost on the paid tier is expected to be negligible. Without the key, dietary-matched
# venue suggestions silently degrade to none — generation still works.
YELP_API_KEY=

# Sign up at brave.com/search/api. No free tier as of 2026: $5/month prepaid credit, card
# required, then metered usage (~$0.003-0.005/query). This app's real volume (~1 search per trip
# generation) keeps expected cost well under $1/month. Without the key, destination festival
# suggestions silently degrade to none — generation still works.
BRAVE_API_KEY=

# Required only when LLM_TRANSPORT=api (see CLAUDE.md). Unset/default "cli" means local dev
# keeps using the claude CLI subprocess for free and none of the below is needed.
# LLM_TRANSPORT=api
# ANTHROPIC_API_KEY=
# Hard daily spend cap (USD) on live generation, enforced only when LLM_TRANSPORT=api. Unset
# means no cap — fine for local dev, not for a public deploy.
# DAILY_SPEND_CAP_USD=
# Overrides where the SQLite file lives — set on Railway to the persistent volume's mount path.
# DB_PATH=
