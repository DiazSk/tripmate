# Free Cesium ion account + access token: https://cesium.com/ion/signup
# Used to stream Google's Photorealistic 3D Tiles via createGooglePhotorealistic3DTileset().
# No Google Cloud project or billing account needed. Without this set, the map falls back
# to plain OpenStreetMap imagery on a flat-terrain globe.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Required in every environment (see CLAUDE.md) — POI suggestions silently degrade to none
# without it, they do not error.
OPENTRIPMAP_API_KEY=

# Required only when LLM_TRANSPORT=api (see CLAUDE.md). Unset/default "cli" means local dev
# keeps using the claude CLI subprocess for free and none of the below is needed.
# LLM_TRANSPORT=api
# ANTHROPIC_API_KEY=

# Model routing, API transport only — see src/lib/llmConfig.ts. The CLI transport
# ignores all three and stays pinned to claude-sonnet-4-5, whose timeout constants
# in claude.ts were calibrated against it.
#   strong -> generate, refine, rebalance, critique (writes or judges a whole plan)
#   cheap  -> chat, element-edit, place-detail, context (bounded work on known facts)
# Both default to the values shown; set them only to override.
# LLM_MODEL_STRONG=claude-opus-5
# LLM_MODEL_CHEAP=claude-haiku-4-5
# Chat follows the cheap tier unless given its own model. Set this to
# claude-sonnet-5 if Haiku starts emitting ops the patch applier rejects.
# LLM_MODEL_CHAT=claude-sonnet-5
# Server-side refusal fallback, on by default for the strong tier. Set to 0 to
# send plain requests if the beta flag is ever retired.
# LLM_REFUSAL_FALLBACK=0
# Hard daily spend cap (USD) on live generation, enforced only when LLM_TRANSPORT=api. Unset
# means no cap — fine for local dev, not for a public deploy.
# DAILY_SPEND_CAP_USD=
# Overrides where the SQLite file lives — set on Railway to the persistent volume's mount path.
# DB_PATH=

# Optional. The map's search control ("find cafés near this view") uses Google Places when this is
# set and OpenStreetMap through Overpass when it is not — see src/lib/placeSearch.ts. Google needs
# a billing account, so the app ships on the free path; adding the key swaps the provider with no
# code change and buys ratings, addresses and better coverage of very new venues.
#
# Overpass is a shared community server that rate-limits exactly the traffic a search box makes.
# The UI reports being throttled as "search is busy" rather than as "nothing found", and the
# client fails across three mirrors before saying so.
GOOGLE_PLACES_API_KEY=
