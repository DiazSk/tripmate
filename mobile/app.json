{
  "expo": {
    "name": "TripMate",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tripmate",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121110",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.tripmate",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "app.tripmate",
      "userInterfaceStyle": "dark",
      "backgroundColor": "#121110",
      "adaptiveIcon": {
        "backgroundColor": "#121110",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121110",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-apple-authentication",
      "@clerk/expo-google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TripMate uses your location to show how far your saved places are while a trip is running. It is never sent anywhere."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TripMate reads the places in screenshots you pick, and saves a photo you choose for your profile."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsImageWithMaxCount": 20,
            "NSExtensionActivationSupportsMovieWithMaxCount": 3
          },
          "iosAppGroupIdentifier": "group.app.tripmate.shared",
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*"
          ]
        }
      ],
      "./plugins/withSceneLifecycle",
      "./plugins/withRandomPodUuids",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
